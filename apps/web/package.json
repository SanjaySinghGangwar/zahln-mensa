{
  "name": "@zahln/web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Studierendenwerk dashboard: daily totals, payments that need attention, search with full history, CSV export.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "deploy": "npm run build && firebase deploy --only hosting"
  },
  "dependencies": {
    "@zahln/core": "*",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "~19.3.0",
    "@types/react-dom": "~19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^25.0.1",
    "vite": "^8.3.5"
  }
}
